model WebPushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.VarChar(2048)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model Identity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  type            IdentityType
  value           String       @db.VarChar(320)
  normalizedValue String       @db.VarChar(320)
  credentialHash  String?      @db.VarChar(512)
  verifiedAt      DateTime?    @db.Timestamptz(6)
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([type, normalizedValue])
  @@index([userId])
  @@index([type, normalizedValue])
  @@map("identities")
}

model ProviderProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  userId             String       @db.Uuid
  providerNumber     String       @db.VarChar(100)
  providerType       ProviderType
  professionalTitle  String?      @db.VarChar(150)
  specialty          String?      @db.VarChar(200)
  subspecialty       String?      @db.VarChar(200)
  registrationNumber String?      @db.VarChar(150)
  registrationBody   String?      @db.VarChar(200)
  licenseNumber      String?      @db.VarChar(150)
  licenseExpiryDate  DateTime?    @db.Date
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?    @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  encounters            Encounter[]
  clinicalNotesAuthored ClinicalNote[]         @relation("ClinicalNoteProviderAuthor")
  appointments          Appointment[]
  appointmentSlotHolds   AppointmentSlotHold[]
  availabilityRules     ProviderAvailability[]
  availabilityBlocks    AvailabilityBlock[]

  @@unique([tenantId, userId])
  @@unique([tenantId, providerNumber])
  @@index([tenantId, status])
  @@index([tenantId, providerType])
  @@index([userId, status])
  @@index([tenantId, specialty])
  @@map("provider_profiles")
}

