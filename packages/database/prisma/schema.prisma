  sessions                           Session[]
  devices                            Device[]
  apiKeys                            ApiKey[]
  patientProfile                     PatientProfile?
  registrations                      Registration[]
  registrationSessions               RegistrationSession[]
  verificationChallenges             VerificationChallenge[]
  auditEvents                        AuditEvent[]                       @relation("AuditActor")
  cashierSales                       Sale[]                             @relation("SaleCashier")
  cashierRefunds                     SaleRefund[]                       @relation("SaleRefundCashier")
