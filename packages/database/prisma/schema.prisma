  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  appointmentId   String             @db.Uuid
  fromStatus      AppointmentStatus?
  toStatus        AppointmentStatus
  reason          String?            @db.VarChar(1000)
  changedByUserId String             @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  changedByUser User        @relation("AppointmentStatusChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, appointmentId, createdAt])
  @@index([changedByUserId, createdAt])
  @@map("appointment_status_history")
}

model ProviderAvailability {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  providerId      String    @db.Uuid
  branchId        String?   @db.Uuid
  departmentId    String?   @db.Uuid
  serviceId       String?   @db.Uuid
  dayOfWeek       Int
  startMinute     Int
  endMinute       Int
  timeZone        String    @db.VarChar(100)
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  slotDurationMin Int?
  isActive        Boolean   @default(true)
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch        Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  service       Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdByUser User            @relation("ProviderAvailabilityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, providerId, isActive, dayOfWeek])
  @@index([tenantId, branchId, isActive])
  @@index([tenantId, departmentId, isActive])
  @@index([tenantId, serviceId, isActive])
  @@map("provider_availability")
}

model AvailabilityBlock {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  providerId      String?  @db.Uuid
  branchId        String?  @db.Uuid
  departmentId    String?  @db.Uuid
  serviceId       String?  @db.Uuid
  startAt         DateTime @db.Timestamptz(6)
  endAt           DateTime @db.Timestamptz(6)
  reason          String?  @db.VarChar(1000)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider      ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  service       Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdByUser User             @relation("AvailabilityBlockCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, startAt, endAt])
  @@index([tenantId, providerId, startAt, endAt])
  @@index([tenantId, branchId, startAt, endAt])
  @@index([tenantId, departmentId, startAt, endAt])
  @@map("availability_blocks")
}

model ProductBatch {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  productId    String   @db.Uuid
  batchNumber  String   @db.VarChar(100)
  expiryDate   DateTime @db.Date
  quantity     Int      @default(0)
  costPrice    Decimal  @db.Decimal(12, 2)
  supplierName String?  @db.VarChar(200)
  receivedAt   DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems            SaleItem[]
  stockMovements       StockMovement[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  shopOrderItems       ShopOrderItem[]

  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId, expiryDate])
  @@map("product_batches")
}

model Sale {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  cashierUserId String            @db.Uuid
  saleNumber    String            @db.VarChar(100)
  status        SaleStatus        @default(COMPLETED)
  paymentStatus SalePaymentStatus @default(PAID)
  currency      String            @db.VarChar(3)
  subtotal      Decimal           @db.Decimal(12, 2)
  discountTotal Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  amountPaid    Decimal           @default(0) @db.Decimal(12, 2)
  changeDue     Decimal           @default(0) @db.Decimal(12, 2)
  customerName  String?           @db.VarChar(200)
  customerPhone String?           @db.VarChar(50)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  cashier        User            @relation("SaleCashier", fields: [cashierUserId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       SalePayment[]
  refunds        SaleRefund[]
  stockMovements StockMovement[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @db.Uuid
  productId      String   @db.Uuid
  batchId        String   @db.Uuid
  productName    String   @db.VarChar(200)
  sku            String   @db.VarChar(100)
  batchNumber    String   @db.VarChar(100)
  expiryDate     DateTime @db.Date
  unit           String   @db.VarChar(40)
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @db.Decimal(6, 3)
  lineTotal      Decimal  @db.Decimal(12, 2)

  sale    Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId, batchId])
  @@map("sale_items")
}

model SalePayment {
  id        String            @id @default(uuid()) @db.Uuid
  saleId    String            @db.Uuid
  method    SalePaymentMethod
  status    SalePaymentStatus @default(PAID)
  amount    Decimal           @db.Decimal(12, 2)
  reference String?           @db.VarChar(200)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

model SaleRefund {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  saleId        String   @db.Uuid
  cashierUserId String   @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  reason        String   @db.VarChar(500)
  stockReturned Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sale    Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  cashier User   @relation("SaleRefundCashier", fields: [cashierUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([saleId])
  @@map("sale_refunds")
}

model HeldShopSale {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  cashierUserId String   @db.Uuid
  payload       Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashier User   @relation(fields: [cashierUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, cashierUserId, createdAt])
  @@map("held_shop_sales")
}

model StockMovement {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  userId                String            @db.Uuid
  productId             String            @db.Uuid
  batchId               String            @db.Uuid
  saleId                String?           @db.Uuid
  shopOrderId           String?           @db.Uuid
  purchaseReceiptItemId String?           @db.Uuid
  purchaseReturnItemId  String?           @db.Uuid
  type                  StockMovementType
  quantity              Int
  reason                String            @db.VarChar(500)
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch               ProductBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sale                Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  shopOrder           ShopOrder?           @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  purchaseReceiptItem PurchaseReceiptItem? @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: Restrict)
  purchaseReturnItem  PurchaseReturnItem?  @relation(fields: [purchaseReturnItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([productId, batchId, createdAt])
  @@index([saleId])
  @@index([shopOrderId])
  @@index([purchaseReceiptItemId])
  @@index([purchaseReturnItemId])
  @@map("stock_movements")
}
