  @@index([tenantId, queueEntryId, createdAt])
  @@index([tenantId, toStatus, createdAt])
  @@index([changedByUserId, createdAt])
  @@map("queue_entry_history")
}

model Encounter {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  patientTenantRecordId String  @db.Uuid
  providerId            String? @db.Uuid
  branchId              String? @db.Uuid
  departmentId          String? @db.Uuid
  createdByUserId       String  @db.Uuid
  appointmentId         String? @unique @db.Uuid

  encounterNumber String          @db.VarChar(100)
  type            EncounterType
  status          EncounterStatus @default(DRAFT)
  reason          String?         @db.VarChar(1000)

  startedAt       DateTime? @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)
  cancelledAt     DateTime? @db.Timestamptz(6)
  cancelledReason String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patientTenantRecord PatientTenantRecord      @relation(fields: [patientTenantRecordId], references: [id], onDelete: Restrict)
  provider            ProviderProfile?         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  branch              Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department          Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdByUser       User                     @relation("EncounterCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  appointment         Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  statusHistory       EncounterStatusHistory[]
  clinicalNotes       ClinicalNote[]
  queueEntries        QueueEntry[]

  patientJourneys        PatientJourney[]
  journeySteps           PatientJourneyStep[]
  patientJourneyHandoffs PatientJourneyHandoff[]
  queueCareRecords       QueueCareRecord[]

  @@unique([tenantId, encounterNumber])
  @@index([tenantId, status])
  @@index([tenantId, patientTenantRecordId, createdAt])
  @@index([tenantId, providerId, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, departmentId, status])
  @@index([createdByUserId])
  @@map("encounters")
}

model ClinicalNote {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  patientTenantRecordId String  @db.Uuid
  encounterId           String  @db.Uuid
  authorUserId          String  @db.Uuid
  authorProviderId      String? @db.Uuid

  noteNumber String             @db.VarChar(100)
  type       ClinicalNoteType
  status     ClinicalNoteStatus @default(DRAFT)

  chiefComplaint String? @db.VarChar(2000)
  subjective     String? @db.Text
  objective      String? @db.Text
  assessment     String? @db.Text
  plan           String? @db.Text

  signedAt    DateTime? @db.Timestamptz(6)
  finalizedAt DateTime? @db.Timestamptz(6)
  voidedAt    DateTime? @db.Timestamptz(6)
  voidReason  String?   @db.VarChar(1000)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

