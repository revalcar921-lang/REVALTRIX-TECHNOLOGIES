}

enum QueueCallStatus {
  CALLED
  ACKNOWLEDGED
  EXPIRED
  CANCELLED
}

model QueueCall {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  queueEntryId   String @db.Uuid
  calledByUserId String @db.Uuid

  callNumber Int
  status     QueueCallStatus @default(CALLED)

  calledAt       DateTime  @default(now()) @db.Timestamptz(6)
  acknowledgedAt DateTime? @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  cancelledAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)
  calledByUser User       @relation("QueueCallCaller", fields: [calledByUserId], references: [id], onDelete: Restrict)

  @@unique([queueEntryId, callNumber])
  @@index([tenantId, queueEntryId, createdAt])
  @@index([tenantId, status, calledAt])
  @@index([calledByUserId, createdAt])
