model PatientJourney {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  patientTenantRecordId String  @db.Uuid
  encounterId           String? @db.Uuid

  status PatientJourneyStatus @default(ACTIVE)

  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patientTenantRecord PatientTenantRecord @relation(fields: [patientTenantRecordId], references: [id], onDelete: Restrict)
  encounter           Encounter?          @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  steps    PatientJourneyStep[]
  handoffs PatientJourneyHandoff[]

  @@index([tenantId, status])
  @@index([tenantId, patientTenantRecordId, status])
  @@index([tenantId, encounterId])
  @@map("patient_journeys")
}

model PatientJourneyHandoff {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  journeyId   String  @db.Uuid
  encounterId String? @db.Uuid

  fromStepId String? @db.Uuid
  toStepId   String? @db.Uuid

  fromBranchId     String? @db.Uuid
  fromDepartmentId String? @db.Uuid
  toBranchId       String? @db.Uuid
  toDepartmentId   String? @db.Uuid

  status PatientJourneyHandoffStatus @default(PENDING)

  reason      String? @db.VarChar(1000)
  instruction String? @db.VarChar(1000)

  initiatedByUserId String @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  acceptedAt  DateTime? @db.Timestamptz(6)
  rejectedAt  DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journey   PatientJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  encounter Encounter?     @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  fromStep PatientJourneyStep? @relation("HandoffFromStep", fields: [fromStepId], references: [id], onDelete: Restrict)
  toStep   PatientJourneyStep? @relation("HandoffToStep", fields: [toStepId], references: [id], onDelete: Restrict)

  fromBranch Branch? @relation("HandoffFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch? @relation("HandoffToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)

  fromDepartment Department? @relation("HandoffFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartment   Department? @relation("HandoffToDepartment", fields: [toDepartmentId], references: [id], onDelete: Restrict)

  initiatedByUser User @relation("PatientJourneyHandoffInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, journeyId, status])
  @@index([tenantId, encounterId])
  @@index([tenantId, fromDepartmentId, status])
  @@index([tenantId, toDepartmentId, status])
  @@index([tenantId, initiatedByUserId])
  @@map("patient_journey_handoffs")
}

model PatientJourneyStep {
  id        String @id @default(uuid()) @db.Uuid
  journeyId String @db.Uuid
  tenantId  String @db.Uuid

  sequence Int
  type     PatientJourneyStepType
  status   PatientJourneyStepStatus @default(PENDING)

  name        String  @db.VarChar(200)
  description String? @db.VarChar(1000)

  branchId     String? @db.Uuid
  departmentId String? @db.Uuid
  encounterId  String? @db.Uuid
  queueId      String? @db.Uuid
  queueEntryId String? @db.Uuid

  location    String? @db.VarChar(300)
  instruction String? @db.VarChar(1000)

  estimatedWaitMinutes     Int?
  estimatedDurationMinutes Int?

  readyAt     DateTime? @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  journey      PatientJourney          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  handoffsFrom PatientJourneyHandoff[] @relation("HandoffFromStep")
  handoffsTo   PatientJourneyHandoff[] @relation("HandoffToStep")
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  encounter    Encounter?              @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  queue        Queue?                  @relation(fields: [queueId], references: [id], onDelete: Restrict)
  queueEntry   QueueEntry?             @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)

  @@unique([journeyId, sequence])
  @@index([tenantId, status])
  @@index([tenantId, journeyId, sequence])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, queueEntryId])
  @@map("patient_journey_steps")
}

